// Snippet to merge into ~/.config/waybar/config.jsonc:
//   1. add "custom/mimarchy" to "modules-right" (next to "bluetooth", "network")
//   2. add this block alongside the other "custom/*" entries
//
// The glyph is U+F0335 (nf-md-lightbulb), a solid bulb that matches the weight
// of the tray icons beside it. Waybar writes it back as the surrogate escape
// "󰌵"; that is the same character, not a different one. Confirm any
// replacement by rendering it — this module has twice shipped a codepoint that
// existed in the font but was not the glyph anyone expected.
{
  "custom/mimarchy": {
    "format": "󰌵",
    "on-click": "omarchy-launch-mimarchy",
    "tooltip-format": "Mimarchy — LEDs, sensors, cooler display"
  }
}
