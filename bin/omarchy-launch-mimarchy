#!/bin/bash

# omarchy:summary=Launch the mimarchy TUI (fan/GPU LEDs, CPU display toggle).
#
# Omarchy's own launcher is preferred and does the interesting parts: it derives
# the app-id (`org.omarchy.mimarchy-tui`, which the window rules key off), opens
# the user's chosen terminal via xdg-terminal-exec rather than a hardcoded one,
# runs the window in its own systemd scope, and focuses an already-open instance
# instead of stacking a second.
#
# The fallback exists so the same launcher works on a machine without Omarchy —
# it can only open a window, not focus an existing one. `xdg-terminal-exec` is
# tried next, because it is a freedesktop convention rather than an Omarchy
# invention and honours the user's terminal choice.
#
# Only then is a terminal named directly, and the app-id flag is not uniform:
# foot spells it `--app-id=`, Alacritty, Ghostty and kitty spell it `--class=`
# (all four take `-e`). Guessing one spelling for all of them fails outright on
# the other family — and foot is Omarchy 4's default terminal, so guessing
# `--class` is the wrong guess to make. The flags below are the ones Omarchy
# itself uses in omarchy-launch-screensaver.
#
# Last of all, run in the current terminal rather than not at all. That is the
# right end of the ladder for an unknown terminal: `mimarchy-tui` is a TUI, so
# an inline run is a working program, whereas a wrong --class flag is an error
# message.

set -euo pipefail

APP_ID="org.omarchy.mimarchy-tui"

if command -v omarchy-launch-or-focus-tui >/dev/null 2>&1; then
  exec omarchy-launch-or-focus-tui mimarchy-tui
fi

if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --app-id="$APP_ID" -e mimarchy-tui
fi

for term in "${TERMINAL:-}" foot alacritty ghostty kitty; do
  [[ -n "$term" ]] && command -v "$term" >/dev/null 2>&1 || continue
  case "$(basename "$term")" in
    foot) exec "$term" --app-id="$APP_ID" -e mimarchy-tui ;;
    alacritty | ghostty | kitty) exec "$term" --class="$APP_ID" -e mimarchy-tui ;;
    *) exec "$term" -e mimarchy-tui ;;
  esac
done

exec mimarchy-tui
